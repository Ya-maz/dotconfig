# alias aireview='git show | aichat --role %code-reviewer-new%'
alias aireview='time ( \
    echo "=== AI Code Review ===" && \
    echo "Branch: $(git branch --show-current)" && \
    echo "Commit message: $(git log -1 --pretty=format:%s)" && \
    echo "Commit: $(git rev-parse --short HEAD)" && \
    echo "Author: $(git log -1 --pretty=format:%an)" && \
    echo "Date: $(date)" && \
    echo && \
    echo "aichat --role %code-reviewer-new%" && \
    echo "AI review processing..." && \
    git show | aichat --role %code-reviewer-new% > ~/jobs/intech/codebase/temp/temp-ai-checkcode.md &&\
    echo -e "\u001b[1;32m✓\u001b[0m Review completed. Results saved to: ~/jobs/intech/codebase/temp/temp-ai-checkcode.md")'

